{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eviconsist:silver-label:v1",
  "title": "EviConsist assistant-generated silver label v1",
  "type": "object",
  "required": ["schema_version", "label_origin", "source_id", "task_type", "source", "source_sha256", "target", "target_sha256", "policy_version", "policy_sha256", "dataset_role", "annotation_status", "decision", "quality", "silver_label", "gold", "human_review_complete", "human_adjudication_complete", "independent_human_validation", "full_target_review_complete", "reviewer_id", "reviewer_model_id", "decision_rationale", "spans", "uncertain_claims", "localization_complete", "review_effort_seconds", "provenance"],
  "properties": {
    "schema_version": {"const": "eviconsist-silver-v1"},
    "label_origin": {"const": "assistant_generated"},
    "source_id": {"type": "string", "minLength": 1},
    "task_type": {"enum": ["Summary", "QA", "Data2txt"]},
    "source": {"type": ["string", "object"]},
    "source_sha256": {"$ref": "#/$defs/hash"},
    "target": {"type": "string", "minLength": 1},
    "target_sha256": {"$ref": "#/$defs/hash"},
    "policy_version": {"const": "silver-v1"},
    "policy_sha256": {"$ref": "#/$defs/hash"},
    "dataset_role": {"enum": ["reference_only", "annotation_policy_pilot", "research_development", "confirmatory_test"]},
    "annotation_status": {"enum": ["pending", "completed"]},
    "decision": {"enum": ["pending", "positive", "negative", "uncertain", "quality_excluded"]},
    "quality": {"enum": [null, "adequate", "incorrect_refusal", "truncated", "source_ambiguous", "other_exclusion"]},
    "silver_label": {"enum": [null, 0, 1]},
    "gold": {"const": null},
    "human_review_complete": {"const": false},
    "human_adjudication_complete": {"const": false},
    "independent_human_validation": {"const": false},
    "full_target_review_complete": {"type": "boolean"},
    "reviewer_id": {"type": ["string", "null"]},
    "reviewer_model_id": {"type": ["string", "null"]},
    "decision_rationale": {"type": "string"},
    "spans": {"type": "array", "items": {"allOf": [{"$ref": "#/$defs/claim"}, {"properties": {"kind": {"enum": ["unsupported", "contradiction"]}}}]}},
    "uncertain_claims": {"type": "array", "items": {"allOf": [{"$ref": "#/$defs/claim"}, {"properties": {"kind": {"const": "uncertain"}}}]}},
    "localization_complete": {"type": "boolean"},
    "review_effort_seconds": {"type": ["number", "null"], "minimum": 0},
    "provenance": {"type": "object"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evidence": {"type": "object", "required": ["pointer"], "properties": {"pointer": {"type": "string"}, "quote": {"type": ["string", "null"]}, "value": {}}},
    "claim": {
      "type": "object",
      "required": ["start", "end", "text", "kind", "rationale", "confidence", "source_evidence"],
      "properties": {
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 1},
        "text": {"type": "string", "minLength": 1},
        "kind": {"enum": ["unsupported", "contradiction", "uncertain"]},
        "rationale": {"type": "string", "minLength": 1},
        "confidence": {"enum": ["high", "medium-high", "medium", "medium-low", "low"]},
        "source_evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}
      }
    }
  },
  "$comment": "silver_labels.validate additionally checks target/source hashes, exact offsets and evidence, decision/quality consistency and training-role gates. This schema does not establish semantic correctness."
}
